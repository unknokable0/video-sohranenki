<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#0B0911</item>
        <item name="android:statusBarColor">#0B0911</item>
        <item name="android:navigationBarColor">#0B0911</item>
        <item name="colorPrimary">#8B5CF6</item>
        <item name="colorSecondary">#A78BFA</item>
    </style>

    <style name="AppTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#07143A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/sohr_brand_logo</item>
        <item name="windowSplashScreenAnimationDuration">650</item>
        <item name="windowSplashScreenIconBackgroundColor">#07143A</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
